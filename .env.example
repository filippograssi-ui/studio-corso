# ===== STUDIO: variabili da inserire su Vercel (Settings -> Environment Variables) =====

# Chiave Claude (console.anthropic.com). Consiglio: metti un limite di spesa mensile.
ANTHROPIC_API_KEY=

# Modello usato per modificare i siti (facoltativo)
# STUDIO_MODEL=claude-sonnet-5

# OAuth App di GitHub (GitHub -> Settings -> Developer settings -> OAuth Apps -> New)
# Authorization callback URL:  https://IL-TUO-STUDIO.vercel.app/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Una frase lunga a caso (almeno 20 caratteri): protegge i cookie di accesso
SESSION_SECRET=

# Il codice del corso: lo scrivi alla lavagna, serve per entrare in Studio
STUDIO_CODE=

# Facoltativo: elenco (separato da virgole) dei nomi GitHub ammessi. Vuoto = chi ha il codice
# STUDIO_ALLOWED_USERS=
